#include <windows.h>

#define IDI_MONITORIA 101

IDI_MONITORIA ICON "../../installer/monitoria.ico"
1 RT_MANIFEST "desktop-host.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,3,0
 PRODUCTVERSION 1,0,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "BIGCORPS TECNOLOGIA LTA\0"
            VALUE "FileDescription", "MonitorIA Desktop Host\0"
            VALUE "FileVersion", "1.0.3.0\0"
            VALUE "InternalName", "monitoria-desktop.exe\0"
            VALUE "OriginalFilename", "monitoria-desktop.exe\0"
            VALUE "ProductName", "MonitorIA\0"
            VALUE "ProductVersion", "1.0.3.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
