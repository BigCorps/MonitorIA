{
  "name": "@monitoria/agent",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "MonitorIA Agent local para câmeras RTSP.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "build:js": "tsc",
    "build:win": "bun build ./src/index.ts --compile --target=bun-windows-x64 --outfile ./dist/monitoria-agent.exe"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
