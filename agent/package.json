{
  "name": "@monitoria/agent",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "MonitorIA Agent local para câmeras RTSP.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit -p ./tsconfig.json",
    "build:js": "tsc -p ./tsconfig.json",
    "build:win": "bun build ./src/index.ts --compile --no-compile-autoload-dotenv --no-c
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14"
}
