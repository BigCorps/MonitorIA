# Aplicação web
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Operadores internos separados por vírgula.
# Esta lista libera /dashboard/operations/ai; não use e-mails de clientes.
MONITORIA_INTERNAL_OPERATOR_EMAILS=admin@empresa.com

# Pareamento e autenticação do Agent — mínimo de 32 caracteres
MONITORIA_AGENT_SECRET=

# Protege os endpoints de cron — mínimo de 16 caracteres
CRON_SECRET=

# Banco Inter / ponte Pix já utilizada pela BigCorps
BANCO_INTER_API_KEY=
BANCO_INTER_BRIDGE_BASE_URL=https://inter.btsolucao.com.br

# Visão
OPENAI_API_KEY=
VISION_PROVIDER=openai
VISION_PROFILE_MODEL=gpt-5-mini
VISION_MODEL_ECONOMIC=gpt-5-nano
VISION_MODEL_BALANCED=gpt-5-nano
VISION_MODEL_DETAILED=gpt-5-mini
VISION_MODEL_ESCALATION=gpt-5-mini
VISION_STORE_RESPONSES=false

# Detalhe e limites por modo
VISION_DETAIL_ECONOMIC=low
VISION_DETAIL_BALANCED=low
VISION_DETAIL_DETAILED=low
VISION_MAX_OUTPUT_ECONOMIC=1600
VISION_MAX_OUTPUT_BALANCED=2400
VISION_MAX_OUTPUT_DETAILED=3200
VISION_PROFILE_DETAIL=high
VISION_PROFILE_MAX_OUTPUT_TOKENS=5000

# Compatibilidade temporária com o roteador anterior.
# A INT-3.5 substituirá a decisão por confiança pelo gateway de complexidade.
VISION_BALANCED_ESCALATION_CONFIDENCE=0.75

# Validação A/B — mantenha false fora do período de testes
VISION_AB_TEST_ENABLED=false
VISION_AB_TEST_SAMPLE_PERCENT=100
VISION_AB_TEST_MAX_PER_CAMERA=50

# Preços por 1 milhão de tokens
VISION_MINI_INPUT_USD_PER_1M=0.25
VISION_MINI_CACHED_INPUT_USD_PER_1M=0.025
VISION_MINI_OUTPUT_USD_PER_1M=2
VISION_NANO_INPUT_USD_PER_1M=0.05
VISION_NANO_CACHED_INPUT_USD_PER_1M=0.005
VISION_NANO_OUTPUT_USD_PER_1M=0.40

# Compatibilidade com configurações anteriores
VISION_MODEL=gpt-5-mini
VISION_DETAIL=low
VISION_MAX_OUTPUT_TOKENS=3000
VISION_INPUT_USD_PER_1M=0.25
VISION_OUTPUT_USD_PER_1M=2

# O câmbio operacional passa a ser mantido em public.ai_cost_settings.
# Esta variável permanece apenas para código legado que ainda a consulte.
COST_USD_TO_BRL=6

# Texto e relatórios — etapa futura
GROQ_API_KEY=
