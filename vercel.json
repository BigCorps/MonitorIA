{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "pdx1"
  ],
  "crons": [
    {
      "path": "/api/cron/billing",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/trials",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/camera-health",
      "schedule": "2-59/5 * * * *"
    },
    {
      "path": "/api/cron/processes",
      "schedule": "3-59/5 * * * *"
    },
    {
      "path": "/api/cron/staff-profiles",
      "schedule": "4-59/5 * * * *"
    },
    {
      "path": "/api/cron/routines",
      "schedule": "7-59/15 * * * *"
    },
    {
      "path": "/api/cron/ai-usage",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/assistant-credits",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "20 3 * * *"
    }
  ]
}
